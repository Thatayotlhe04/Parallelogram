[6.1399, "o", "\u001b[1;36m  i \u001b[0m\u001b[2m(global) \u001b[0m\u001b[36m[context-window] \u001b[0mContext-window counts are \r\napproximate\r\n"]
[6.1462, "o", "      \u001b[2m→ no tokenizer specified — pass --tokenizer \u001b[0m\u001b[1;2m<\u001b[0m\u001b[1;2;95mmodel\u001b[0m\u001b[1;2m>\u001b[0m\u001b[2m \u001b[0m\r\n\u001b[1;2m(\u001b[0m\u001b[2me.g. gpt-4o, Qwen/Qwen2.\u001b[0m\u001b[1;2;36m5\u001b[0m\u001b[2m-7B\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m for an exact count\u001b[0m\r\n"]
[6.1465, "o", "\u001b[1;31m  ✗ \u001b[0m\u001b[2mdata/train.jsonl:377 \u001b[0m\u001b[36m[eval-overlap] \u001b[0mRecord also appears \r\nin the eval set (eval.jsonl:42)\r\n"]
[6.1471, "o", "      \u001b[2m→ Training on eval examples inflates the eval score; \u001b[0m\r\n\u001b[2m--fix drops this train record\u001b[0m\r\n"]
[6.1475, "o", "\u001b[1;33m  ! \u001b[0m\u001b[2mdata/train.jsonl:412 \u001b[0m\u001b[36m[pii] \u001b[0mMessage 0 contains a phone \r\nnumber: …0461\r\n"]
[6.148, "o", "      \u001b[2m→ The model can learn and repeat it; --fix replaces it\u001b[0m\r\n\u001b[2mwith a placeholder\u001b[0m\r\n"]
[6.1484, "o", "\u001b[1;31m  ✗ \u001b[0m\u001b[2mdata/train.jsonl:640 \u001b[0m\u001b[36m[roles] \u001b[0mMessage 2: Conversation \r\nmust end on 'assistant'\r\n"]
[6.1487, "o", "\u001b[1;33m  ! \u001b[0m\u001b[2mdata/train.jsonl:731 \u001b[0m\u001b[36m[encoding] \u001b[0mMessage 0 contains \r\nlikely mojibake: 'â€™'\r\n"]
[6.1492, "o", "      \u001b[2m→ UTF-\u001b[0m\u001b[1;2;36m8\u001b[0m\u001b[2m → latin-\u001b[0m\u001b[1;2;36m1\u001b[0m\u001b[2m → UTF-\u001b[0m\u001b[1;2;36m8\u001b[0m\u001b[2m round-trip artifact\u001b[0m\r\n"]
[6.1495, "o", "\u001b[1;31m  ✗ \u001b[0m\u001b[2mdata/train.jsonl:1022 \u001b[0m\u001b[36m[empty-content] \u001b[0mMessage 1 \r\n(role=assistant) has empty content\r\n"]
[6.1497, "o", "\u001b[1;31m  ✗ \u001b[0m\u001b[2mdata/train.jsonl:1450 \u001b[0m\u001b[36m[tool-calls] \u001b[0mMessage 1, call 0: \r\nfunction name is not declared in tools\r\n"]
[6.1499, "o", "\u001b[1;33m  ! \u001b[0m\u001b[2mdata/train.jsonl:1576 \u001b[0m\u001b[36m[encoding] \u001b[0mMessage 0 contains \r\nlikely mojibake: 'â€™'\r\n"]
[6.1501, "o", "      \u001b[2m→ UTF-\u001b[0m\u001b[1;2;36m8\u001b[0m\u001b[2m → latin-\u001b[0m\u001b[1;2;36m1\u001b[0m\u001b[2m → UTF-\u001b[0m\u001b[1;2;36m8\u001b[0m\u001b[2m round-trip artifact\u001b[0m\r\n"]
