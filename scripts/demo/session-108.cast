[6.046, "o", "      \u001b[2m→ UTF-\u001b[0m\u001b[1;2;36m8\u001b[0m\u001b[2m → latin-\u001b[0m\u001b[1;2;36m1\u001b[0m\u001b[2m → UTF-\u001b[0m\u001b[1;2;36m8\u001b[0m\u001b[2m round-trip artifact\u001b[0m\r\n"]
