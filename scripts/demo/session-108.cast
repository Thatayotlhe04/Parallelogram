[6.0428, "o", "      \u001b[2m→ no tokenizer specified — pass --tokenizer \u001b[0m\u001b[1;2m<\u001b[0m\u001b[1;2;95mmodel\u001b[0m\u001b[1;2m>\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2me.g. gpt-4o, Qwen/Qwen2.\u001b[0m\u001b[1;2;36m5\u001b[0m\u001b[2m-7B\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m for an exact count\u001b[0m\r\n"]
[6.0431, "o", "\u001b[1;31m  ✗ \u001b[0m\u001b[2mdata/train.jsonl:377 \u001b[0m\u001b[36m[eval-overlap] \u001b[0mRecord also appears in the eval set (eval.jsonl:42)\r\n"]
[6.0434, "o", "      \u001b[2m→ Training on eval examples inflates the eval score; --fix drops this train record\u001b[0m\r\n"]
[6.0437, "o", "\u001b[1;33m  ! \u001b[0m\u001b[2mdata/train.jsonl:412 \u001b[0m\u001b[36m[pii] \u001b[0mMessage 0 contains a phone number: …0461\r\n"]
[6.0441, "o", "      \u001b[2m→ The model can learn and repeat it; --fix replaces it with a placeholder\u001b[0m\r\n"]
[6.0443, "o", "\u001b[1;31m  ✗ \u001b[0m\u001b[2mdata/train.jsonl:640 \u001b[0m\u001b[36m[roles] \u001b[0mMessage 2: Conversation must end on 'assistant'\r\n"]
[6.0444, "o", "\u001b[1;33m  ! \u001b[0m\u001b[2mdata/train.jsonl:731 \u001b[0m\u001b[36m[encoding] \u001b[0mMessage 0 contains likely mojibake: 'â€™'\r\n"]
[6.0451, "o", "      \u001b[2m→ UTF-\u001b[0m\u001b[1;2;36m8\u001b[0m\u001b[2m → latin-\u001b[0m\u001b[1;2;36m1\u001b[0m\u001b[2m → UTF-\u001b[0m\u001b[1;2;36m8\u001b[0m\u001b[2m round-trip artifact\u001b[0m\r\n"]
